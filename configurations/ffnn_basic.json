{
  "environment": "BipedalWalker-v3",
  "random_seed": 123,
  "number_generations": 5,
  "optimizer": {
    "type": "CMA_ES",
    "population_size": 5,
    "sigma": 1.0,
    "mu": 5,
    "fix_seed_for_generation": false
  },
  "brain": {
    "type": "FeedForward",
    "use_bias": true,
    "hidden_layers": [[8, 8]],
    "neuron_activation": "relu"
  },
  "episode_runner": {
    "keep_env_seed_fixed_during_generation": false
  }
}
