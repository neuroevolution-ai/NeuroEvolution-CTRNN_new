{
  "environment": "ReacherMemory-v0",
  "random_seed": 0,
  "number_generations": 2500,
  "optimizer": {
    "type": "CMA_ES",
    "population_size": 200,
    "sigma": 1.0,
    "checkpoint_frequency": 10,
    "hof_size": 10,
    "mu": 25,
    "efficiency_weight": 0.0,
    "fix_seed_for_generation": false
  },
  "brain": {
    "type": "Concatenated_LSTM",
    "normalize_input": false,
    "normalize_input_target": 5,
    "use_bias": true,
    "feed_forward_front": {
      "type": "FeedForward_NumPy",
      "normalize_input": false,
      "normalize_input_target": 2,
      "use_bias": true,
      "hidden_layers": [16],
      "neuron_activation": "relu"
    },
    "lstm": {
      "type": "LSTM",
      "use_bias": true,
      "hidden_layer_structure": [1],
      "optimize_initial_neuron_state": false
    },
    "feed_forward_back": {
      "type": "FeedForward",
      "normalize_input": false,
      "normalize_input_target": 2,
      "use_bias": true,
      "hidden_layers": [8],
      "neuron_activation": "relu"
    }
  },
  "episode_runner": {
    "number_fitness_runs": 25,
    "reuse_env": true,
    "keep_env_seed_fixed_during_generation": true,
    "max_steps_per_run": 0,
    "max_steps_penalty": 0,
    "use_autoencoder": false,
    "environment_attributes": {
      "observation_frames": 20,
      "memory_frames": 20,
      "action_frames": 50
    }
  }
}
